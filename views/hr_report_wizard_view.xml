<odoo>
    <record id="view_invoice_employee_report_wizard" model="ir.ui.view">
        <field name="name">hr.report.wizard.form</field>
        <field name="model">hr.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar reporte de facturas por empleado">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="user_id"/>
                </group>
                <group string="Filtros fijos">
                    <field name="move_type_info" readonly="1"/>
                    <field name="state_info" readonly="1"/>
                    <field name="payment_state_info" readonly="1"/>
                </group>
                <footer>
                    <button string="Generar Reporte RRHH"
                            type="object"
                            name="action_generate_xlsx"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_report_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte</field>
        <field name="res_model">hr.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>